Configs: {
	HjsonConfig: {
		DisplayName: Hjson配置

		ModifyManageModName: {
			# VeluriyamLibHjson.Destroyer.ModifyModName class
			# region ModifyManageModName
			Label: 修改管理模组页面中模组名称
			Tooltip:
				'''
				该功能对于添加了其他修改管理模组页面的Mod不生效
				可能与更好的体验出现冲突,但已经尽量避免
				该配置可以开关该功能，默认开启
				'''
		}

		ShowBuffDetailHint: {
			Label: 在物品描述中添加显示Buff详情功能提示
			Tooltip:
				'''
				Hjson提供了一个可以让Mod作者轻松在物品描述中显示Buff图标
				并在按下后可以显示Buff详情的功能
				该配置可以开关是否在物品描述中提示该功能，默认开启
				'''
		}

		ImageTooltipBuff: {
			Label: 显示Buff详情
			Tooltip:
				'''
				Hjson提供了一个可以让Mod作者轻松在物品描述中显示Buff图标
				并在按下后可以显示Buff详情的功能
				该配置可以开关该功能，默认开启
				'''
		}

		EnableDebug: {
			Label: 启用Debug模式
			Tooltip: "[c/FF0000:这是一个提供给开发者的配置！切勿开启！]"
		}
	}
}

Logs: {
	ErrorWarning: "[这是一个报错!请联系Mod作者!]"
	# VeluriyamLibHjson.Core.VLanguage class
	CanNotGetText: "{$ErrorWarning}无法获取LocalizedText(SafeGetText方法)!"
	CanNotGetTextValue: "{$ErrorWarning}无法获取string(SafeGetTextValue方法)!"
}

Items: {
	TestItem: {
		DisplayName: Test Item
		Tooltip:
			'''
			This is an example keybind display.
			[vkb/VeluriyamLib/DashKey:Key:Name]
			[vkb/VeluriyamLib/DashKey:Key]
			[vkb/VeluriyamLib/DashKey:Name]
			[vkb/VeluriyamLib/DashKey:Name:Key]
			[vkb/Terraria/Throw:NameJesusChristKey]
			'''
	}
}

Keybinds.ShowBuffDetail.DisplayName: 显示Buff详情
# 对应绑定按键的替换，当提供对应按键的Mod未加载时会返回这段文本
ModifyTooltips.CanNotFoundKeybind: <未找到>
ImageTooltip.CanShowBuffDetail: ⌈Hjson⌋:按住[[vkb/VeluriyamLibHjson/ShowBuffDetail:Name:Key]]以显示Buff详细信息
